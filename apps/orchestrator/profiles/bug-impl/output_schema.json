{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["pr_url", "branch", "files_changed", "tests_added", "tests_run", "tokens_used", "cost_usd"],
  "additionalProperties": false,
  "properties": {
    "pr_url": { "type": "string" },
    "branch": { "type": "string" },
    "files_changed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tests_added": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tests_run": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tokens_used": { "type": "integer", "minimum": 0 },
    "cost_usd": { "type": "number", "minimum": 0 }
  }
}
