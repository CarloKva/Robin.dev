# Robin.dev desktop client — copy to .env.local for dev.
# Mirrors apps/web/.env shape; only the public Supabase keys are needed here.

# Supabase project (shared with web).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Web origin — REST + the desktop-session OAuth endpoint live here.
VITE_API_BASE_URL=http://localhost:3000

# Public sign-in URL for the system-browser OAuth handoff. Clerk dashboard
# must allowlist robin://auth/callback for the desktop app to receive the
# PKCE redirect.
VITE_SIGN_IN_URL=http://localhost:3000/sign-in?redirect_url=robin%3A%2F%2Fauth%2Fcallback

# Deep-link scheme. Match src-tauri/tauri.conf.json.
VITE_DEEP_LINK_SCHEME=robin

# Telemetry (optional — leave empty to disable).
VITE_SENTRY_DSN=
VITE_APP_VERSION=0.0.1

# Auto-updater manifest (used by the marketing download page).
NEXT_PUBLIC_DESKTOP_MANIFEST_URL=https://downloads.robin.dev/desktop/manifest.json
