{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for popover + expanded windows. Grants the renderer access to every Rust command this app exposes plus the deep-link / notification / store plugin defaults.",
  "windows": ["popover", "expanded"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:allow-internal-toggle-devtools",
    "deep-link:default",
    "notification:default",
    "notification:allow-notify",
    "store:default",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-delete",
    "store:allow-save",
    {
      "identifier": "core:webview:allow-create-webview-window",
      "allow": [{ "label": "popover" }, { "label": "expanded" }]
    }
  ]
}
